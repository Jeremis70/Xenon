{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": { "pattern": "^.*\\{[^}\"']*$" },
    "decreaseIndentPattern": { "pattern": "^\\s*\\}" }
  },
  "onEnterRules": [
    {
      "beforeText": { "pattern": "^\\s*//.*$" },
      "action": { "indent": "none", "appendText": "// " }
    }
  ]
}
