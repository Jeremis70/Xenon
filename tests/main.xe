// Testing MVP for xenon programming language
#[entry]
fn main()->i32
{
    let i32 x = 0;
    while x < 10
    {
        x++;
    }
    return fibonacci(x);
}

fn fibonacci(i32 n)->i32
{
    if n == 0
    {
        return 0;
    }
    else if n == 1
    {
        return 1;
    }
    else
    {
        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}
