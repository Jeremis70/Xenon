// Exits with 0 when every check holds, or with the number of the first
// check that fails.
#[entry]
fn main() -> u8
{
    let i32 x = 0;
    let *i32 y = @x;
    let u8 a = 5;
    let u10 count = 5 + a as u10;
    while x < count
    {
        x++;
    }
    *y += 2;

    // Multiple results, destructured into new variables: 12 = 1 * 7 + 5.
    let i32 q, i32 r = divmod(x, 7);
    // Parallel assignment: both values are read before either is stored.
    q, r = r, q;

    return 1 unless fibonacci(x) == 144;
    return 2 unless (q, r) == (5, 1);
    // The largest Fibonacci number that fits in an `i32`.
    return 3 unless fibonacci(46) == 1836311903;

    // A struct, built from its fields in any order.
    let Rect rect = Rect(height = r, width = q);
    return 4 unless rect.area == 5;
    // A `&self` method changes the value it is called on.
    rect.scale(3);
    return 5 unless rect == Rect(width = 15, height = 3) and rect.area == 45;
    return 6 unless Rect.square(4).scaled(2).area == 64;
    return 0;
}

struct Rect
{
    i32 width;
    i32 height;
}

impl Rect
{
    // Computed on every read; it takes no room in the struct.
    i32 area
    {
        return self.width * self.height;
    }

    fn scaled(self, i32 factor) -> Rect
    {
        return Rect(width = self.width * factor, height = self.height * factor);
    }

    fn scale(&self, i32 factor)
    {
        self.width *= factor;
        self.height *= factor;
    }

    fn square(i32 side) -> Rect
    {
        return Rect(width = side, height = side);
    }
}

fn fibonacci(i32 n) -> i32
{
    return 0 if n <= 0;
    let i32 a, i32 b = 0, 1;
    let i32 count = 1;
    while count < n
    {
        a, b = b, a + b;
        count++;
    }
    return b;
}

fn divmod(i32 n, i32 d) -> i32 q, i32 r
{
    q = n / d;
    r = n % d;
    return;
}
