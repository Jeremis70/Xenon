// Testing MVP for xenon programming language
fn main()->u8
{
    u32 x = 0;
    while x < 10
    {
        x++;
    }
    return fibonacci(x);
}

fn fibonacci(u32 n)->u32
{
    if n == 0
    {
        return 0;
    }
    else if n == 1
    {
        return 1;
    }
    else
    {
        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}
